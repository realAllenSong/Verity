{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verity.local/schemas/data-record.schema.json",
  "title": "Verity Data Record",
  "type": "object",
  "required": ["record_id", "dataset_id", "batch_id", "ingested_at", "payload"],
  "properties": {
    "record_id": { "type": "string", "minLength": 1 },
    "dataset_id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "batch_id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "ingested_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object", "additionalProperties": true },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
