  "info": {
    "summary": "All-Go local-first, white-box data curation with optional ingestion and durable orchestration adapters.",
    "title": "Verity API",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/imports": {
      "post": {
        "operationId": "create_import",
        "parameters": [{"in": "header", "name": "Idempotency-Key", "required": true, "schema": {"maxLength": 200, "type": "string"}}],
        "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/ImportCreate"}}}, "required": true},
        "responses": {"202": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/ImportResponse"}}}, "description": "Resumable import created"}},
        "summary": "Create Import"
      }
    },
    "/api/v1/uploads/{upload_id}": {
      "head": {
        "operationId": "inspect_upload",
        "parameters": [{"in": "path", "name": "upload_id", "required": true, "schema": {"type": "string"}}],
        "responses": {"204": {"description": "Current upload offset", "headers": {"Upload-Offset": {"schema": {"type": "integer"}}}}},
        "summary": "Inspect Upload Offset"
      },
      "patch": {
        "operationId": "append_upload",
        "parameters": [
          {"in": "path", "name": "upload_id", "required": true, "schema": {"type": "string"}},
          {"in": "header", "name": "Upload-Offset", "required": true, "schema": {"minimum": 0, "type": "integer"}}
        ],
        "requestBody": {"content": {"application/offset+octet-stream": {"schema": {"format": "binary", "type": "string"}}}, "required": true},
        "responses": {"204": {"description": "Upload chunk committed"}},
        "summary": "Append Upload Chunk"
      }
    },
    "/api/v1/imports/{import_id}/complete": {
      "post": {
        "operationId": "complete_import",
        "parameters": [
          {"in": "path", "name": "import_id", "required": true, "schema": {"type": "string"}},
          {"in": "header", "name": "Idempotency-Key", "required": true, "schema": {"maxLength": 200, "type": "string"}}
        ],
        "responses": {"202": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/JobResponse"}}}, "description": "Automatic pipeline job created"}},
        "summary": "Complete Import And Start Pipeline"
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "operationId": "get_job",
        "parameters": [{"in": "path", "name": "job_id", "required": true, "schema": {"type": "string"}}],
