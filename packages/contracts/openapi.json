{
  "components": {
    "schemas": {
      "DecisionBreakdown": {
        "properties": {
          "accepted": {
            "title": "Accepted",
            "type": "integer"
          },
          "rejected": {
            "title": "Rejected",
            "type": "integer"
          },
          "review": {
            "title": "Review",
            "type": "integer"
          }
        },
        "required": [
          "accepted",
          "review",
          "rejected"
        ],
        "title": "DecisionBreakdown",
        "type": "object"
      },
      "EvidenceRecord": {
        "properties": {
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "decision": {
            "enum": [
              "accepted",
              "rejected",
              "modified",
              "review"
            ],
            "title": "Decision",
            "type": "string"
          },
          "evidence_count": {
            "default": 1,
            "title": "Evidence Count",
            "type": "integer"
          },
          "extracted_signal": {
            "title": "Extracted Signal",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "occurred_at": {
            "title": "Occurred At",
            "type": "string"
          },
          "privacy": {
            "default": "manager-safe summary",
            "title": "Privacy",
            "type": "string"
          },
          "raw_event": {
            "title": "Raw Event",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "signal_type": {
            "title": "Signal Type",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "source_label": {
            "title": "Source Label",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source",
          "source_label",
          "raw_event",
          "extracted_signal",
          "signal_type",
          "confidence",
          "decision",
          "reason",
          "occurred_at"
        ],
        "title": "EvidenceRecord",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PipelineStage": {
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "input_count": {
            "title": "Input Count",
            "type": "integer"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "operator": {
            "title": "Operator",
            "type": "string"
          },
          "status": {
            "default": "complete",
            "enum": [
              "complete",
              "review",
              "idle"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "count",
          "input_count",
          "description",
          "operator"
        ],
        "title": "PipelineStage",
        "type": "object"
      },
      "ReviewUpdate": {
        "properties": {
          "decision": {
            "enum": [
              "accepted",
              "rejected",
              "modified"
            ],
            "title": "Decision",
            "type": "string"
          },
          "note": {
            "default": "",
            "maxLength": 500,
            "title": "Note",
            "type": "string"
          }
        },
        "required": [
          "decision"
        ],
        "title": "ReviewUpdate",
        "type": "object"
      },
      "RunResponse": {
        "properties": {
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "stage_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Stage Counts",
            "type": "object"
          },
          "state": {
            "enum": [
              "succeeded",
              "failed"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "state",
          "stage_counts"
        ],
        "title": "RunResponse",
        "type": "object"
      },
      "SourceSummary": {
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "state": {
            "default": "healthy",
            "enum": [
              "healthy",
              "warning",
              "offline"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "count"
        ],
        "title": "SourceSummary",
        "type": "object"
      },
      "StepSettings": {
        "properties": {
          "code_version": {
            "title": "Code Version",
            "type": "string"
          },
          "input_snapshot": {
            "title": "Input Snapshot",
            "type": "string"
          },
          "operator": {
            "title": "Operator",
            "type": "string"
          },
          "output_snapshot": {
            "title": "Output Snapshot",
            "type": "string"
          },
          "policy": {
            "title": "Policy",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "threshold": {
            "title": "Threshold",
            "type": "number"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "operator",
          "version",
          "policy",
          "threshold",
          "code_version",
          "input_snapshot",
          "output_snapshot",
          "run_id"
        ],
        "title": "StepSettings",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WorkspaceResponse": {
        "properties": {
          "copy_policy": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Copy Policy",
            "type": "object"
          },
          "decision_breakdown": {
            "$ref": "#/components/schemas/DecisionBreakdown"
          },
          "generated_at": {
            "title": "Generated At",
            "type": "string"
          },
          "project": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Project",
            "type": "object"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/EvidenceRecord"
            },
            "title": "Records",
            "type": "array"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "schema_after": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "title": "Schema After",
            "type": "array"
          },
          "schema_before": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "title": "Schema Before",
            "type": "array"
          },
          "signal_distribution": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Signal Distribution",
            "type": "object"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceSummary"
            },
            "title": "Sources",
            "type": "array"
          },
          "stages": {
            "items": {
              "$ref": "#/components/schemas/PipelineStage"
            },
            "title": "Stages",
            "type": "array"
          },
          "step_settings": {
            "$ref": "#/components/schemas/StepSettings"
          }
        },
        "required": [
          "project",
          "generated_at",
          "run_id",
          "sources",
          "stages",
          "records",
          "decision_breakdown",
          "step_settings",
          "signal_distribution",
          "schema_before",
          "schema_after",
          "copy_policy"
        ],
        "title": "WorkspaceResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Language-neutral control-plane reference for white-box data curation.",
    "title": "Verity API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/review-queue": {
      "get": {
        "operationId": "review_queue_api_v1_review_queue_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Review Queue Api V1 Review Queue Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Review Queue"
      }
    },
    "/api/v1/reviews/{record_id}": {
      "patch": {
        "operationId": "update_review_api_v1_reviews__record_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "record_id",
            "required": true,
            "schema": {
              "title": "Record Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Review"
      }
    },
    "/api/v1/runs": {
      "post": {
        "operationId": "run_recipe_api_v1_runs_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Run Recipe"
      }
    },
    "/api/v1/stages/{stage_id}/preview": {
      "get": {
        "operationId": "stage_preview_api_v1_stages__stage_id__preview_get",
        "parameters": [
          {
            "in": "path",
            "name": "stage_id",
            "required": true,
            "schema": {
              "title": "Stage Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Stage Preview Api V1 Stages  Stage Id  Preview Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Stage Preview"
      }
    },
    "/api/v1/workspace": {
      "get": {
        "operationId": "workspace_api_v1_workspace_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Workspace"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
